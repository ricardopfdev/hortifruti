# Copie para env.local e preencha com seus dados.
# O arquivo env.local NÃO é enviado ao GitHub.
#
# Windows (PowerShell):
#   Copy-Item env.local.example env.local
#
# IntelliJ: a Run Configuration "HortifrutiApplication" carrega este arquivo automaticamente.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hortifruti
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=SUA_SENHA_AQUI

# Credenciais de acesso ao sistema (altere em produção)
HORTIFRUTI_ADMIN_USERNAME=admin
HORTIFRUTI_ADMIN_PASSWORD=admin123
HORTIFRUTI_ATENDENTE_USERNAME=atendente
HORTIFRUTI_ATENDENTE_PASSWORD=atendente123
